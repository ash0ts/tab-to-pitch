# Local development. Copy to .env; keep real values private.
# npm does not load .env automatically: use node --env-file=.env --import tsx server/index.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173

CLOUD_COACH_ENABLED=false
DATABASE_URL=
SESSION_SECRET=
WANDB_API_KEY=
FORGE_PROJECT=
FORGE_MODEL=openai/gpt-oss-20b
FORGE_BASE_URL=https://api.inference.wandb.ai/v1
FORGE_DAILY_TOKEN_LIMIT=1000000
FORGE_TRACING_ENABLED=false

# An isolated, disposable database. Integration tests apply migrations.
TEST_DATABASE_URL=

# Enable only after the arrangement model passes its frozen evaluation gates.
ARRANGEMENT_AGENT_ENABLED=false

# Separate experimental opt-in. Qualification status does not prevent invited testing.
TEACHER_AGENT_ENABLED=false
TEACHER_QUALIFICATION=unqualified
# Defaults to FORGE_MODEL. A separately qualified model can review the actor's prose.
TEACHER_CRITIC_MODEL=openai/gpt-oss-20b

# A prior prompt's qualification does not qualify a revised actor or critic.
TEACHER_QUALIFIED_PROMPT=
TEACHER_QUALIFIED_CRITIC=
TEACHER_QUALIFIED_MODEL=
TEACHER_QUALIFIED_CRITIC_MODEL=

# Local research audio worker; disabled on hosted/non-loopback deployments.
EAR_LAB_ENABLED=false
EAR_LAB_PYTHON=audio_worker/.venv/bin/python
EAR_LAB_DATA_DIR=.local/audio
EAR_LAB_RESEARCH_MODE=false
HF_TOKEN=
EAR_LAB_BASIC_PITCH_CHECKPOINT=
