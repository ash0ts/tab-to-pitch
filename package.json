{
  "name": "tab-to-pitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "patch:alphatab": "node scripts/patch-alphatab.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "invite": "tsx scripts/invitation.ts",
    "postinstall": "node scripts/patch-alphatab.mjs",
    "predev": "node scripts/patch-alphatab.mjs",
    "prebuild": "node scripts/patch-alphatab.mjs",
    "eval:replay": "tsx evals/replay.ts",
    "test:renderer": "playwright test --config tests/renderer.playwright.config.ts",
    "test:offline": "playwright test --config tests/offline.playwright.config.ts",
    "format": "prettier --write src server tests docs evals scripts/*.ts *.json *.ts *.md",
    "format:check": "prettier --check src server tests docs evals scripts/*.ts *.json *.ts *.md",
    "test:live": "playwright test --config tests/live-guitar.playwright.config.ts",
    "test:ear": "playwright test --config tests/ear.playwright.config.ts",
    "test:studio": "playwright test --config tests/studio.playwright.config.ts"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@coreweave/forge-sdk": "0.1.0-beta.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "fastify": "5.12.7",
    "fft.js": "4.0.4",
    "idb": "8.0.4",
    "lucide-react": "0.577.0",
    "openai": "6.49.0",
    "pg": "8.23.1",
    "pitchy": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tonal": "6.5.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "1.8.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5",
    "weave": "0.16.10"
  }
}
