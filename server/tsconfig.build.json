{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "..",
    "outDir": "../.server-build",
    "types": ["node"],
    "sourceMap": false
  },
  "include": [
    "./**/*.ts",
    "../scripts/invitation.ts",
    "../scripts/migrate.ts",
    "../scripts/backup.ts",
    "../scripts/restore.ts",
    "../src/shared/coach.ts"
  ],
  "exclude": ["./**/*.test.ts", "./test-repository.ts"]
}
